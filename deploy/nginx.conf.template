# Serves the built SPA and reverse-proxies JPL's SSD API (which sends no CORS
# headers) under same-origin /jpl. CelesTrak and NASA allow CORS and are called
# directly from the browser, so they are not proxied here.
# ${PORT} is substituted at container start by the nginx image entrypoint.

server {
    listen       ${PORT};
    server_name  _;
    root   /usr/share/nginx/html;
    index  index.html;

    gzip on;
    gzip_comp_level 6;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # JPL SSD/CNEOS API (CAD + SBDB) -> https://ssd-api.jpl.nasa.gov
    location /jpl/ {
        proxy_pass https://ssd-api.jpl.nasa.gov/;
        proxy_set_header Host ssd-api.jpl.nasa.gov;
        proxy_ssl_server_name on;
        proxy_set_header Accept application/json;
        proxy_http_version 1.1;
    }

    # Cache built, content-hashed assets aggressively.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
